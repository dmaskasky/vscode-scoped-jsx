{
  "name": "vscode-scoped-styles-languageserver",
  "displayName": "scoped-styles Language Server",
  "description": "Language server for scoped-styles",
  "version": "1.3.1",
  "author": {
    "name": "David Maskasky",
    "email": "dmaskasky@gmail.com",
    "url": "https://github.com/dmaskasky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dmaskasky/vscode-scoped-styles"
  },
  "license": "MIT",
  "publisher": "dmaskasky",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:javascriptreact",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:typescript",
    "onCommand:scopedStyles.applyCodeAction"
  ],
  "main": "./client/out/extension",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "publish": "vsce publish",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
    "package": "vsce package",
    "lint": "cd client && npm run lint && cd ../server && npm run lint && cd ..",
    "format": "cd client && npm run format && cd ../server && npm run format && cd ..",
    "test": "npm run compile && sh ./scripts/e2e.sh"
  },
  "dependencies": {
    "typescript": "4.5.5"
  },
  "devDependencies": {
    "@types/mocha": "^9.1.0",
    "@types/node": "^17.0.18",
    "mocha": "^9.2.1",
    "snazzy": "^9.0.0",
    "ts-standard": "^11.0.0",
    "vsce": "^2.6.7"
  },
  "packageManager": "pnpm@8.15.0"
}
